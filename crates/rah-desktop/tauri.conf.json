{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAH",
  "version": "0.9.0",
  "identifier": "org.rust-agent-harness.desktop",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "title": "RAH",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis"
  }
}
